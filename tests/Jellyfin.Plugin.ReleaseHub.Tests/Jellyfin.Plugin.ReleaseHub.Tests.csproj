<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors the plugin: each target runs the suite against the build compiled for that Jellyfin
         generation (net9.0 -> 10.11, net10.0 -> 12.x), so neither can regress unnoticed. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- A developer machine may lack the .NET 9 shared runtime. Rolling forward lets the net9.0 tests
         execute there anyway; it affects the test host only, never the shipped assembly. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Test methods do not need XML documentation, and CA1707 fights the Given_When_Then naming
         that makes a failing test readable in CI output. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same advisory the plugin project suppresses. Here the native SQLite does load, but only inside
         the test host, against fixture data; nothing from this project is ever shipped. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jellyfin.Plugin.ReleaseHub\Jellyfin.Plugin.ReleaseHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured provider responses. Tests parse these instead of calling the live APIs: the suite
         must pass offline, must not consume anyone's rate limit budget, and must fail when a mapper
         breaks rather than when a network call flakes. -->
    <None Update="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
